{
  "name": "koota-animation",
  "version": "0.0.4",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "description": "Keyframe animation for koota traits, with an optional three.js transform bridge",
  "license": "MIT",
  "author": "Mara Kim <mara@astralarium.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astralarium/koota-animation.git"
  },
  "keywords": [
    "koota",
    "ecs",
    "animation",
    "keyframes",
    "tween",
    "easing",
    "three"
  ],
  "bugs": {
    "url": "https://github.com/astralarium/koota-animation/issues"
  },
  "homepage": "https://github.com/astralarium/koota-animation#readme",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js",
      "default": "./dist/three/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm check-types && pnpm lint && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "koota": "0.6.6-canary.0531fe1",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "koota": "0.6.6-canary.0531fe1",
    "prettier": "^3.9.9",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
